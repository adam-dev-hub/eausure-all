# Example environment variables for EauSure Admin API

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/eausure_admin

# JWT secret used to validate access tokens
JWT_SECRET=replace_with_a_strong_secret

# Local server port
PORT=3000

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Upstream hardware API base URL
HARDWARE_API_URL=https://eau-sure-api.vercel.app
